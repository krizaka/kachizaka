# Kachizaka — local development. Copy to .env; never commit .env.
APP_PUBLIC_URL=http://localhost:3000
# A database of your own (one per worktree/session), PostgreSQL 16.
DATABASE_URL=postgresql://kachizaka:kachizaka@localhost:5432/kachizaka_dev
# LISTEN needs a direct connection (not a transaction pooler); defaults to DATABASE_URL.
DATABASE_DIRECT_URL=
REALTIME_BUS=postgres
AUTH_SESSION_SECRET=
AUTH_SIGNUP_ENABLED=false
AUTH_ALLOWED_IPS=
# Orazaka's edge and Kachizaka's oz_ service key (the sports-feed connector runs there).
AI_API_URL=https://dev.orazaka.com/edge
AI_API_KEY=
