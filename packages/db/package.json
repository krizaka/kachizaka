{
  "name": "@kachizaka/db",
  "version": "0.1.0",
  "private": true,
  "description": "Kachizaka's PostgreSQL 16 schema (Drizzle, versioned SQL migrations), the rules the database itself enforces (sealed rule sets, predictions locked at kick-off, ordered facts), and the ingestion pipeline — tested on a real PostgreSQL.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./seed": "./src/seed.ts"
  },
  "scripts": {
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx src/seed-cli.ts",
    "sync": "tsx scripts/sync.ts"
  },
  "dependencies": {
    "@kachizaka/core": "workspace:*",
    "@kachizaka/mcp": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "tsx": "^4.23.15"
  }
}
